# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

# Conexão com o MySQL (usuário/senha iguais aos do docker-compose.yml)
DATABASE_URL=mysql+pymysql://atendimento:atendimento@localhost:3306/controle_atendimento

# Chave usada para assinar os tokens de login. Gere uma sua com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-uma-chave-gerada
JWT_EXPIRA_MINUTOS=480

# Expediente do laboratório
FUSO_HORARIO=America/Recife
HORA_INICIO_EXPEDIENTE=7
HORA_FIM_EXPEDIENTE=17

# true = permite emitir/chamar senhas fora do expediente.
# Use SOMENTE para a demonstração em sala (a aula é à noite, fora das 7h-17h).
IGNORAR_EXPEDIENTE=false

# Regra de alternância das chamadas (ver docs/decisoes.md):
#   DIAGRAMA = [SP] -> [SE|SG] -> [SP] -> [SE|SG]   (padrão)
#   CICLO    = SP -> SE -> SG -> SP -> SE -> SG
MODO_ALTERNANCIA=DIAGRAMA
